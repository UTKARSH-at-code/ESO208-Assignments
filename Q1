import numpy as np
import matplotlib.pyplot as plt

m, k = 20, 20
h, T = 1.0, 15
t = np.arange(0, T + h, h)

def f(t, u, c):
    return np.array([u[1], -(c*u[1] + k*u[0])/m])

def rk4(c):
    u = np.zeros((len(t), 2))
    u[0] = [1, 0]
    for i in range(len(t) - 1):
        k1 = f(t[i], u[i], c)
        k2 = f(t[i] + h/2, u[i] + h/2*k1, c)
        k3 = f(t[i] + h/2, u[i] + h/2*k2, c)
        k4 = f(t[i] + h, u[i] + h*k3, c)
        u[i+1] = u[i] + h/6*(k1 + 2*k2 + 2*k3 + k4)
    return u

res = {c: rk4(c) for c in [5, 40, 60]}
print(f"{'t':>4} {'x(c=5)':>10} {'x(c=40)':>10} {'x(c=60)':>10}")
for i in range(len(t)):
    print(f"{t[i]:4.0f} {res[5][i,0]:10.5f} {res[40][i,0]:10.5f} {res[60][i,0]:10.5f}")

for c in res:
    plt.plot(t, res[c][:, 0], 'o-', label=f'c = {c} Ns/m')
plt.xlabel('t (s)')
plt.ylabel('x (m)')
plt.title('Damped spring-mass system (RK4, h = 1 s)')
plt.legend()
plt.grid()
plt.savefig('Q1_plot.png', dpi=150)
