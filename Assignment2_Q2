"""
Assignment 2, Q.2- a, b
Newton-Raphson method: flow depth y for Q = 5 m^3/s in a rectangular channel
Q = sqrt(S) * (B*y)^(5/3) / ( n * (B + 2y)^(2/3) )
"""
import math

B, S, n, Q_target = 20.0, 0.0002, 0.03, 5.0


def f(y):
    """Residual: Q(y) - Q_target."""
    A = B * y                      # flow area
    P = B + 2.0 * y                # wetted perimeter
    return math.sqrt(S) * A**(5.0/3.0) / (n * P**(2.0/3.0)) - Q_target


def df(y):
    """Analytical derivative dQ/dy (product rule on A^(5/3) * P^(-2/3))."""
    A = B * y
    P = B + 2.0 * y
    k = math.sqrt(S) / n
    dA, dP = B, 2.0
    return k * ((5.0/3.0) * A**(2.0/3.0) * dA * P**(-2.0/3.0)
                - (2.0/3.0) * A**(5.0/3.0) * P**(-5.0/3.0) * dP)


def newton_raphson(func, dfunc, x0, tol=1e-10, maxit=100):
    """Newton-Raphson method. Returns root, iterations, iteration table."""
    table = []
    x = x0
    for i in range(1, maxit + 1):
        fx, dfx = func(x), dfunc(x)
        if abs(dfx) < 1e-14:
            raise ZeroDivisionError("Derivative ~ 0; Newton-Raphson fails.")
        x_new = x - fx / dfx                       # x_{i+1} = x_i - f/f'
        ea = abs((x_new - x) / x_new) * 100
        table.append((i, x, fx, dfx, x_new, ea))
        x = x_new
        if ea < tol:
            break
    return x, i, table


if __name__ == "__main__":
    y0 = 1.0                                       # initial guess
    root, nit, table = newton_raphson(f, df, y0)

    print(" it        y_i          f(y_i)        f'(y_i)        y_i+1        ea(%)")
    for i, x, fx, dfx, xn, ea in table:
        print(f"{i:3d} {x:12.8f} {fx:13.3e} {dfx:12.5f} {xn:12.8f} {ea:11.6f}")

    print(f"\nRoot: y = {root:.6f} m  in {nit} iterations")
    print(f"Check: Q({root:.4f}) = {f(root) + Q_target:.6f} m^3/s")
