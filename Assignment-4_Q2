import numpy as np

def cholesky(A):
    n = len(A)
    L = np.zeros((n, n))
    for i in range(n):
        for j in range(i + 1):
            s = np.dot(L[i][:j], L[j][:j])
            if i == j:
                L[i][j] = np.sqrt(A[i][i] - s)
            else:
                L[i][j] = (A[i][j] - s) / L[j][j]
    return L

A = np.array([[8, 20, 15], [20, 80, 50], [15, 50, 60]], dtype=float)
L = cholesky(A)

print("L =\n", L)
print("Check LL^T =\n", L @ L.T)
