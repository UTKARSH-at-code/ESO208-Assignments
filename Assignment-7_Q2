import numpy as np


def Q(t):
    return 8 + 5 * np.cos(0.4 * t) ** 2


def c(t):
    return 5 * np.exp(-0.5 * t) + 3 * np.exp(0.15 * t)


def f(t):
    return Q(t) * c(t)


def trapezoid(f, a, b, n):
    h = (b - a) / n
    x = np.linspace(a, b, n + 1)
    y = f(x)
    return h / 2 * (y[0] + 2 * np.sum(y[1:-1]) + y[-1])


def romberg(f, a, b, es=0.1, maxit=10):
    I = np.zeros((maxit + 1, maxit + 1))
    I[1, 1] = trapezoid(f, a, b, 1)
    ea = 100.0
    for i in range(2, maxit + 1):
        n = 2 ** (i - 1)
        I[i, 1] = trapezoid(f, a, b, n)
        for k in range(2, i + 1):
            j = i - k + 1
            I[j, k] = (4 ** (k - 1) * I[j + 1, k - 1] - I[j, k - 1]) / (4 ** (k - 1) - 1)
        ea = abs((I[1, i] - I[2, i - 1]) / I[1, i]) * 100
        if ea <= es:
            return I[1, i], ea, i, I[1:i + 1, 1:i + 1]
    return I[1, maxit], ea, maxit, I[1:, 1:]


t1, t2 = 2, 8
M, ea, it, table = romberg(f, t1, t2, es=0.1)

print("Romberg Table (rows: n = 1, 2, 4, 8, ... ; columns: O(h^2), O(h^4), O(h^6), ...)")
for i in range(it):
    row = "".join(f"{table[i, k]:14.4f}" for k in range(it - i))
    print(f"n = {2 ** i:<3}" + row)
print()
print(f"Iterations         = {it}")
print(f"Approx. error ea   = {ea:.5f} %")
print(f"Mass transported M = {M:.4f} mg")
