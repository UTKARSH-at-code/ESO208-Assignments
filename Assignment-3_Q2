import numpy as np

def gauss_elimination_pivot(A, b, verbose=True):
    A = np.array(A, dtype=float)
    b = np.array(b, dtype=float).reshape(-1)
    n = A.shape[0]
    if A.shape[0] != A.shape[1] or b.size != n:
        raise ValueError("A must be square and b must match its size")

    Aug = np.hstack([A, b.reshape(-1, 1)])
    sign = 1.0

    if verbose:
        print("Initial augmented matrix [A|b]:")
        show(Aug)

    for k in range(n - 1):
        p = k + int(np.argmax(np.abs(Aug[k:, k])))
        if abs(Aug[p, k]) < 1e-14:
            raise ValueError("Matrix is singular (or nearly so).")
        if p != k:
            Aug[[k, p], :] = Aug[[p, k], :]
            sign = -sign
            if verbose:
                print(f"\nStep {k+1}: swap R{k+1} <-> R{p+1}  (pivot = {Aug[k,k]:.6g})")
                show(Aug)

        for i in range(k + 1, n):
            m = Aug[i, k] / Aug[k, k]
            Aug[i, k:] = Aug[i, k:] - m * Aug[k, k:]
            Aug[i, k] = 0.0
            if verbose:
                print(f"  R{i+1} <- R{i+1} - ({m:.6f}) R{k+1}")
        if verbose:
            print(f"After eliminating column {k+1}:")
            show(Aug)

    if abs(Aug[n - 1, n - 1]) < 1e-14:
        raise ValueError("Matrix is singular (or nearly so).")

    x = np.zeros(n)
    for i in range(n - 1, -1, -1):
        x[i] = (Aug[i, n] - Aug[i, i + 1:n] @ x[i + 1:n]) / Aug[i, i]

    det = sign * np.prod(np.diag(Aug[:, :n]))
    return x, det

def show(M):
    for row in M:
        print("   [" + "  ".join(f"{v:10.5f}" for v in row) + " ]")

if __name__ == "__main__":
    A = [[ 2.0, -6.0, -1.0],
         [-3.0, -1.0,  7.0],
         [-8.0,  1.0, -2.0]]
    b = [-38.0, -34.0, -20.0]

    print("GAUSS ELIMINATION WITH PARTIAL PIVOTING")
    x, det = gauss_elimination_pivot(A, b, verbose=True)

    print("\nSolution:")
    for i, v in enumerate(x, 1):
        print(f"   x{i} = {v: .10f}")
    print(f"\n   det(A) = {det:.6f}")

    r = np.array(b) - np.array(A) @ x
    print(f"   residual = {np.max(np.abs(r)):.3e}")
