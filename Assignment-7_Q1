import numpy as np

y = np.array([0, 2, 4, 6, 8, 10, 12, 14], dtype=float)
H = np.array([0, 1, 1.5, 3, 3.5, 3.2, 2, 0])
U = np.array([0, 0.1, 0.12, 0.2, 0.25, 0.3, 0.15, 0])
HU = H * U


def trapezoidal(x, f):
    h = x[1] - x[0]
    return h / 2 * (f[0] + 2 * np.sum(f[1:-1]) + f[-1])


def simpson13(x, f):
    h = x[1] - x[0]
    return h / 3 * (f[0] + 4 * np.sum(f[1:-1:2]) + 2 * np.sum(f[2:-1:2]) + f[-1])


def simpson38(x, f):
    h = x[1] - x[0]
    return 3 * h / 8 * (f[0] + 3 * f[1] + 3 * f[2] + f[3])


def simpson_combined(x, f):
    n = len(x) - 1
    if n % 2 == 0:
        return simpson13(x, f)
    m = n - 3
    return simpson13(x[:m + 1], f[:m + 1]) + simpson38(x[m:], f[m:])


A_t = trapezoidal(y, H)
Q_t = trapezoidal(y, HU)
A_s = simpson_combined(y, H)
Q_s = simpson_combined(y, HU)

print("Trapezoidal Rule")
print(f"  Area A        = {A_t:.4f} m^2")
print(f"  Discharge Q   = {Q_t:.4f} m^3/s")
print(f"  Avg velocity  = {Q_t / A_t:.4f} m/s")
print()
print("Simpson's Rule (1/3 on 0-8 m, 3/8 on 8-14 m)")
print(f"  Area A        = {A_s:.4f} m^2")
print(f"  Discharge Q   = {Q_s:.4f} m^3/s")
print(f"  Avg velocity  = {Q_s / A_s:.4f} m/s")
print()
print(f"{'Method':<15}{'A (m^2)':>10}{'Q (m^3/s)':>12}{'U_avg (m/s)':>14}")
print(f"{'Trapezoidal':<15}{A_t:>10.4f}{Q_t:>12.4f}{Q_t / A_t:>14.4f}")
print(f"{'Simpson':<15}{A_s:>10.4f}{Q_s:>12.4f}{Q_s / A_s:>14.4f}")
