import numpy as np
import matplotlib.pyplot as plt
from scipy import stats

x = np.array([0.5, 0.8, 1.5, 2.1, 5.4, 3.2, 1.8, 0.9, 2.2, 0.7,
              4.3, 3.8, 4.7, 6.4, 4.1, 3.1, 2.7, 1.6, 0.6, 1.1])
y = np.array([5.12, 7.06, 8.65, 11.78, 26.37, 19.91, 10.57, 7.39, 10.99, 9.36,
              22.35, 22.30, 24.08, 29.91, 20.25, 18.53, 15.25, 11.04, 7.25, 10.08])

n = len(x)
xbar, ybar = np.mean(x), np.mean(y)
Sxx = np.sum((x - xbar)**2)
Sxy = np.sum((x - xbar)*(y - ybar))
Syy = np.sum((y - ybar)**2)

slope = Sxy/Sxx
intercept = ybar - slope*xbar
y_fit = intercept + slope*x
res = y - y_fit
SSE = np.sum(res**2)
var_res = SSE/(n - 2)

print("(a)")
print(f"Slope (b1)            = {slope:.4f}")
print(f"Intercept (b0)        = {intercept:.4f}")
print(f"SSE                   = {SSE:.4f}")
print(f"Variance of residuals = {var_res:.4f}")

plt.figure(figsize=(6, 4))
plt.scatter(x, res, color='b')
plt.axhline(0, color='r', linestyle='--')
plt.xlabel('x')
plt.ylabel('Residual')
plt.title('(b) Residuals vs x')
plt.grid(True)
plt.savefig('residuals_vs_x.png', dpi=150, bbox_inches='tight')

plt.figure(figsize=(6, 4))
plt.hist(res, bins=6, edgecolor='k')
plt.xlabel('Residual')
plt.ylabel('Frequency')
plt.title('(c) Histogram of Residuals')
plt.grid(True)
plt.savefig('histogram_residuals.png', dpi=150, bbox_inches='tight')

R2 = 1 - SSE/Syy
print("\n(d)")
print(f"SST = {Syy:.4f}")
print(f"Coefficient of determination R^2 = {R2:.4f}")

x0 = 7
y0 = intercept + slope*x0
alpha = 0.10
t = stats.t.ppf(1 - alpha/2, n - 2)
se = np.sqrt(var_res*(1 + 1/n + (x0 - xbar)**2/Sxx))
print("\n(e)")
print(f"Predicted y at x = 7  = {y0:.4f}")
print(f"t(0.05, {n-2})           = {t:.4f}")
print(f"Standard error        = {se:.4f}")
print(f"90% CI                = [{y0 - t*se:.4f}, {y0 + t*se:.4f}]")

plt.show()
