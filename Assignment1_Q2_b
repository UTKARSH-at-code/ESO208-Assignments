import numpy as np
import matplotlib.pyplot as plt

T = 1.0                      # period (normalized)
t = np.linspace(0, T, 20001)
w = 2*np.pi/T

y  = np.sin(w*t)
dy = w*np.cos(w*t)

with np.errstate(divide='ignore', invalid='ignore'):
    kappa = np.abs(t*dy/y)   # condition number
kappa[0] = 1.0               # limit at t -> 0

plt.semilogy(t/T, kappa, lw=1.8)
plt.axvline(0.5, ls='--', c='crimson'); plt.axvline(1.0, ls='--', c='crimson')
plt.xlabel('t / T'); plt.ylabel(r'$\kappa = |\theta\cot\theta|$')
plt.grid(True, which='both', alpha=0.3); plt.ylim(1e-3, 1e5)
plt.show()
