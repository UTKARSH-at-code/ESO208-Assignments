import numpy as np
import matplotlib.pyplot as plt

h = 0.1
t = np.arange(0, 1 + h/2, h)
ye = np.zeros(len(t))
yi = np.zeros(len(t))
ye[0] = yi[0] = 1

for n in range(len(t) - 1):
    ye[n+1] = ye[n] + h*(-10*ye[n])
    yi[n+1] = yi[n]/(1 + 10*h)

tt = np.linspace(0, 1, 200)
print(f"{'t':>4} {'Exact':>10} {'Explicit':>10} {'Implicit':>10}")
for i in range(len(t)):
    print(f"{t[i]:4.1f} {np.exp(-10*t[i]):10.6f} {ye[i]:10.6f} {yi[i]:10.6f}")

plt.plot(tt, np.exp(-10*tt), 'k-', label='Analytical')
plt.plot(t, ye, 'ro-', label='Explicit Euler')
plt.plot(t, yi, 'bs-', label='Implicit Euler')
plt.xlabel('t')
plt.ylabel('y')
plt.title("dy/dt = -10y, h = 0.1")
plt.legend()
plt.grid()
plt.savefig('Q2_plot.png', dpi=150)
